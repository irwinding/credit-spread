# Postgres
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit_spread
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://credit:credit@localhost:5433/credit_spread
API_HOST=127.0.0.1
API_PORT=8000

# moomoo OpenD gateway (must be running locally)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_PWD=
# Which moomoo entity holds your account. Common: FUTUSG (Moomoo SG),
# FUTUINC (Moomoo US), FUTUSECURITIES (Futu HK), FUTUAU, FUTUJP, FUTUCA, FUTUMY.
MOOMOO_SECURITY_FIRM=FUTUSG
MOOMOO_TRD_MARKET=US

# Snapshotter
# NOTE: APScheduler's day_of_week is 0=Mon..6=Sun (not standard cron).
# Use weekday names to avoid ambiguity. mon-fri = US trading days.
SNAPSHOT_CRON=*/5 9-16 * * mon-fri
SNAPSHOT_TZ=America/New_York

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
